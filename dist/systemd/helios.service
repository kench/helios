# Helios systemd unit: the identity settings from LLD 1, section 4.5.
# The full unit (sandboxing, watchdog, ordering) is defined in LLD 6.

[Unit]
Description=Helios on-device agent
Wants=network-online.target
After=network-online.target

[Service]
User=helios
# The display module needs the screen (/dev/fb0, root:video). Uncomment where it's enabled; the
# unit fails to start if the group doesn't exist. The scanner's autorun.sh sets it itself.
#SupplementaryGroups=video
# Prepares the token first (LLD 1, section 4.12): with identity.token_copy = "tmpfs", copies the
# master token into /run/helios/token, checks it and falls back to tokens.new or tokens.old if it's
# damaged; either way it writes the SoftHSM config Helios runs with (SOFTHSM2_CONF below), from
# /etc/helios/softhsm2.conf.
ExecStartPre=/usr/bin/helios token prepare --source /etc/helios/softhsm2.conf
ExecStart=/usr/bin/helios
# /run/helios/token: the token's working copy and its SoftHSM config, removed when Helios stops.
RuntimeDirectory=helios/token
RuntimeDirectoryMode=0700
# /var/lib/helios: the Wi-Fi networks Helios keeps (wifi/networks.json), read by helios-wifi.service.
StateDirectory=helios
StateDirectoryMode=0700
Restart=on-failure
# Exit code 78 (EX_CONFIG) means a wrong or locked PIN, or a certificate that doesn't match the
# key. Restarting would spend another PIN try, so don't.
RestartPreventExitStatus=78
# Keep secrets in memory out of core dumps. Helios also calls prctl(PR_SET_DUMPABLE, 0).
LimitCORE=0
# Needed by the SoftHSM2 PKCS#11 module: the config `helios token prepare` writes. Commands run by
# hand while Helios is stopped can use /etc/helios/softhsm2.conf (the master) instead.
Environment=SOFTHSM2_CONF=/run/helios/token/softhsm2.conf
# Development only: with identity.pin = "credential:helios-pin". Devices use
# identity.pin = "bootstrap" and don't need this. Requires systemd 247 or later.
#LoadCredential=helios-pin:/etc/helios/credentials/pin

[Install]
WantedBy=multi-user.target
