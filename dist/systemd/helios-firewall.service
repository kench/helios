# Helios's firewall rules (/etc/helios/firewall.nft, table inet helios): srtla_send's ports for
# loopback only, and RTMP publishing (1935) from private networks only. Needs the nftables
# package. The stream daemon and rtmp-ingest pull it in.

[Unit]
Description=Helios firewall rules
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/helios/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/helios/firewall.nft
ExecStop=/usr/sbin/nft delete table inet helios

[Install]
WantedBy=multi-user.target
