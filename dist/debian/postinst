#!/bin/sh
# helios postinst: the helios, helios-stream and helios-rtmp system users, a restart on upgrade if Helios
# is running, gpsd's control socket made again for the gpsd.socket drop-in, and helios-wifi.path
# and helios-routes.service enabled on a device that has Helios enabled. The services aren't enabled or started on install: a device needs its config and
# token first (provisioning), and then enables helios.service (and helios-stream.service where
# it streams) itself. The stream daemon isn't restarted here: it's told an upgrade is waiting,
# and restarts itself once no stream is live (LLD 4, section 15).
set -e

if [ "$1" = configure ]; then
    if ! getent passwd helios >/dev/null; then
        adduser --system --group --home /nonexistent --no-create-home \
            --gecos "Helios agent" helios
    fi
    if ! getent passwd helios-stream >/dev/null; then
        adduser --system --ingroup helios --home /nonexistent --no-create-home \
            --gecos "Helios stream daemon" helios-stream
    fi
    if ! getent passwd helios-rtmp >/dev/null; then
        adduser --system --group --home /nonexistent --no-create-home \
            --gecos "Helios RTMP ingest (nginx)" helios-rtmp
    fi
    if getent group video >/dev/null; then
        adduser helios-stream video >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        # Upgrades restart a running Helios; installs and stopped services are left alone.
        systemctl try-restart helios.service || true
        # New firewall rules apply at once; nginx reloads a changed config without dropping cameras.
        systemctl try-reload-or-restart helios-firewall.service || true
        systemctl try-reload-or-restart helios-rtmp.service || true
        if systemctl is-active --quiet helios-stream.service; then
            touch /run/helios-stream/restart-pending || true
        fi
        # gpsd's control socket gets the helios group from the drop-in (LLD 10) only when the
        # socket is made again, which needs gpsd stopped (it holds the port). Done once: when the
        # socket isn't the helios group's yet.
        if systemctl is-active --quiet gpsd.socket \
            && [ "$(stat -c %G /run/gpsd.sock 2>/dev/null)" != helios ]; then
            gpsd_was_active=false
            if systemctl is-active --quiet gpsd.service; then
                gpsd_was_active=true
            fi
            systemctl stop gpsd.service gpsd.socket || true
            systemctl start gpsd.socket || true
            if $gpsd_was_active; then
                systemctl start gpsd.service || true
            fi
        fi
        # A provisioned device (Helios enabled) applies Wi-Fi networks from this version on, and
        # keeps source routing for bonded uplinks (LLD 3, section 5; restarted to pick up a new
        # Helios).
        if systemctl is-enabled --quiet helios.service; then
            systemctl enable --now helios-wifi.path || true
            systemctl enable helios-routes.service || true
            systemctl restart helios-routes.service || true
        fi
    fi
fi

exit 0
