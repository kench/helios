#!/bin/sh
# helios prerm: stop Helios and the stream daemon when the package is removed (upgrades restart
# Helios in postinst, and the daemon restarts itself once idle).
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl disable --now helios-wifi.path || true
    systemctl stop helios.service helios-rtmp.service helios-stream.service \
        helios-firewall.service || true
fi

exit 0
